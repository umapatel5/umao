OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# Persistent account/history storage required on Vercel. Never commit a real URL.
DATABASE_URL=

TAVUS_API_KEY=
TAVUS_ECHO_PERSONA_ID=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=
TAVUS_TEST_MODE=true

# Vercel uses Sandbox automatically. Local/non-Vercel execution uses an isolated runner.
# Set UMAO_USE_VERCEL_SANDBOX=true only for intentional local cloud-quota tests.
CODE_RUNNER_SERVICE_URL=
CODE_RUNNER_SERVICE_TOKEN=

# Runner supervisor: required token and per-process container image in production.
RUNNER_SHARED_TOKEN=
RUNNER_SANDBOX_IMAGE=

# Explicit trusted-fixture opt-ins only. Never enable on a public server.
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false
RUNNER_ALLOW_UNSAFE_LOCAL=false
